---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import home from "../data/home.json";
import { getCollection } from "astro:content";

const featuredProjects = (await getCollection("projects", ({ data }) => data.published && data.type === "work"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const latestPost = (await getCollection("blog", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<BaseLayout title={`${site.siteName} | CRM, ERP & Applied AI`}>
  <main>
    <section class="home-hero">
      <div class="hero-text">
        <p class="eyebrow">{home.eyebrow}</p>
        <h1>{home.headline}</h1>
        <p class="hero-lede">{home.lede}</p>
        <div class="hero-actions">
          <a class="primary-link" href={home.primaryAction.href}>{home.primaryAction.label}</a>
          <a class="secondary-link" href={home.secondaryAction.href}>{home.secondaryAction.label}</a>
        </div>
      </div>
      <aside class="profile-card" aria-label={`${site.siteName} profile`}>
        <img class="hero-ribbon-art" src="/assets/hero-ribbons.png" alt="" aria-hidden="true" />
        <div class="profile-monogram" aria-hidden="true">
          <span>CRM</span>
          <span>AI</span>
        </div>
        <div class="profile-caption">
          <strong>{site.siteName}</strong>
          <span>Dynamics 365 · Copilot · Power Platform · CRM modernization</span>
        </div>
      </aside>
    </section>

    <section class="topic-strip" aria-label="Core capabilities">
      {home.capabilities.map((capability) => <span>{capability}</span>)}
    </section>

    <section class="section selected-work">
      <div class="section-heading">
        <p class="eyebrow">Selected project stories</p>
        <a class="secondary-link" href="/work/">View all projects</a>
      </div>
      <div class="selected-work-grid">
        <div class="selected-projects">
          {featuredProjects.map((project) => (
            <article class="selected-project-card">
              <div class="selected-project-meta">
                <span>{project.data.label}</span>
                <strong>{project.data.clientType}</strong>
              </div>
              <div>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
                <a class="secondary-link" href={`/projects/${project.id}/`}>Read story</a>
              </div>
            </article>
          ))}
        </div>
        <aside class="blog-teaser">
          <p class="eyebrow">Ideas, lessons, and field notes</p>
          <h2>Thoughts from the journey.</h2>
          <p>Notes on CRM strategy, Power Platform, applied AI, and making digital change useful in real teams.</p>
          {latestPost && <a class="secondary-link" href={`/blog/${latestPost.id}/`}>Read the latest note</a>}
          <img class="teaser-art" src="/assets/hero-ribbons.png" alt="" aria-hidden="true" />
        </aside>
      </div>
    </section>

    <section class="section personal-intro">
      <div>
        <p class="eyebrow">About me</p>
        <h2>{home.aboutTitle}</h2>
      </div>
      <div class="copy-block">
        {home.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section now-section">
      <div>
        <p class="eyebrow">Now</p>
        <h2>{home.nowTitle}</h2>
      </div>
      <div class="copy-block">
        <p>{home.nowText}</p>
      </div>
    </section>

    <section class="life-band">
      <div class="life-art" aria-hidden="true">
        <img src="/assets/hero-ribbons.png" alt="" />
        <span>People<br />Process<br />Adoption</span>
      </div>
      <div>
        <p class="eyebrow">Personal note</p>
        <h2>{home.personalNoteTitle}</h2>
        <p>{home.personalNote}</p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Explore</p>
        <h2>What you can find here.</h2>
      </div>
      <div class="route-grid">
        {home.routes.map((route) => (
          <a class="route-card" href={route.href}>
            <span>{route.number}</span>
            <h3>{route.title}</h3>
            <p>{route.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section quote-section">
      <p>“{home.quote}”</p>
    </section>
  </main>
</BaseLayout>
