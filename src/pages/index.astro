---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import home from "../data/home.json";
import { getCollection } from "astro:content";
import { BrainCircuit, Boxes, ClipboardCheck, Database, UsersRound, Workflow } from "@lucide/astro";

const featuredProjects = (await getCollection("projects", ({ data }) => data.published && data.type === "work"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const latestPost = (await getCollection("blog", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const routeBanner = (href: string) => {
  if (href.includes("portfolio")) return "portfolio";
  if (href.includes("work")) return "projects";
  if (href.includes("insights")) return "insights";
  if (href.includes("ai-projects")) return "labs";
  if (href.includes("blog")) return "blog";
  return "contact";
};

const capabilityIcons = {
  "Dynamics 365": Database,
  "Copilot & AI": BrainCircuit,
  "Power Platform": Workflow,
  "Business Analysis": ClipboardCheck,
  "CRM & ERP Transformation": Boxes,
};

const embeddedSystemSteps = [
  { label: "Business record", body: "A shared source of truth for the work.", Icon: Database },
  { label: "AI layer", body: "Assistance placed inside the real workflow.", Icon: BrainCircuit },
  { label: "Human decision", body: "Ownership and judgment stay visible.", Icon: UsersRound },
];
---

<BaseLayout title={`${site.siteName} | CRM, ERP & Applied AI`}>
  <main>
    <section class="home-hero">
      <div class="hero-text">
        <p class="eyebrow">{home.eyebrow}</p>
        <h1>{home.headline}</h1>
        <p class="hero-lede">{home.lede}</p>
        <div class="hero-actions">
          <a class="primary-link" href={home.primaryAction.href}>{home.primaryAction.label}</a>
          <a class="secondary-link" href={home.secondaryAction.href}>{home.secondaryAction.label}</a>
        </div>
      </div>
      <aside class="profile-card" aria-label={`${site.siteName} · AI embedded in CRM, ERP, and business systems`}>
        <img class="hero-ribbon-art" src={site.visuals.home} alt="Abstract connected operating model with glowing pathways between business systems" />
        <div class="profile-ai-mark" aria-hidden="true">
          <span>AI</span>
        </div>
        <div class="profile-caption">
          <strong>{site.siteName}</strong>
          <span>AI embedded in CRM, ERP, and business systems.</span>
        </div>
      </aside>
    </section>

    <section class="topic-strip" aria-label="Core capabilities">
      {home.capabilities.map((capability) => {
        const Icon = capabilityIcons[capability as keyof typeof capabilityIcons];
        return (
          <span class="capability-item">
            <Icon class="capability-icon" size={17} strokeWidth={1.6} aria-hidden="true" />
            {capability}
          </span>
        );
      })}
    </section>

    <section class="section selected-work">
      <div class="section-heading">
        <p class="eyebrow">Selected project stories</p>
        <a class="secondary-link" href="/work/">View all projects</a>
      </div>
      <div class="selected-work-grid">
        <div class="selected-projects">
          {featuredProjects.map((project) => (
            <article class="selected-project-card">
              <div class="selected-project-side">
                <figure class="selected-project-visual">
                  <img src={project.data.coverImage || site.visuals.projects} alt={`Business process illustration for ${project.data.title}`} loading="lazy" />
                </figure>
                <div class="selected-project-meta">
                  <span>{project.data.label}</span>
                  <strong>{project.data.clientType}</strong>
                </div>
              </div>
              <div>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
                <a class="secondary-link" href={`/projects/${project.id}/`}>Read story</a>
              </div>
            </article>
          ))}
        </div>
        <aside class="blog-teaser banner-panel banner-panel--compact" data-banner="insights" data-banner-label="Field notes">
          <p class="eyebrow">Ideas, lessons, and field notes</p>
          <h2>Thoughts from the journey.</h2>
          <p>Notes on CRM strategy, Power Platform, applied AI, and making digital change useful in real teams.</p>
          {latestPost && <a class="secondary-link" href={`/blog/${latestPost.id}/`}>Read the latest note</a>}
          <img class="teaser-art" src={site.visuals.insights} alt="" aria-hidden="true" />
        </aside>
      </div>
    </section>

    <section class="section embedded-system-section">
      <div class="section-heading">
        <p class="eyebrow">AI embedded</p>
        <h2>Put intelligence where the work already lives.</h2>
      </div>
      <div class="embedded-system-grid">
        <div class="embedded-system-copy">
          <p>Useful AI is rarely a separate destination. It becomes valuable when it sits close to the records, handoffs, and decisions a team already understands.</p>
          <div class="embedded-system-steps">
            {embeddedSystemSteps.map((step) => {
              const Icon = step.Icon;
              return (
                <div class="embedded-system-step">
                  <Icon class="embedded-system-icon" size={24} strokeWidth={1.6} aria-hidden="true" />
                  <strong>{step.label}</strong>
                  <span>{step.body}</span>
                </div>
              );
            })}
          </div>
        </div>
        <figure class="embedded-system-visual">
          <img src="/assets/ai-enterprise-workflow-diagram.png" alt="Enterprise workflow connecting context, AI assistance, human review, business action, and feedback" loading="lazy" />
          <figcaption>Context → AI assistance → human review → action</figcaption>
        </figure>
      </div>
    </section>

    <section class="section personal-intro">
      <div>
        <p class="eyebrow">About me</p>
        <h2>{home.aboutTitle}</h2>
      </div>
      <div class="copy-block">
        {home.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section now-section">
      <div>
        <p class="eyebrow">Now</p>
        <h2>{home.nowTitle}</h2>
      </div>
      <div class="copy-block">
        <p>{home.nowText}</p>
      </div>
    </section>

    <section class="life-band">
      <div class="life-art" aria-hidden="true">
        <img src="/assets/hero-ribbons.png" alt="" />
        <span>People<br />Process<br />Adoption</span>
      </div>
      <div>
        <p class="eyebrow">Personal note</p>
        <h2>{home.personalNoteTitle}</h2>
        <p>{home.personalNote}</p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Explore</p>
        <h2>What you can find here.</h2>
      </div>
      <div class="route-grid">
        {home.routes.map((route) => (
          <a class="route-card banner-panel" href={route.href} data-banner={routeBanner(route.href)} data-banner-label={route.title}>
            <span>{route.number}</span>
            <h3>{route.title}</h3>
            <p>{route.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section quote-section">
      <p>“{home.quote}”</p>
    </section>
  </main>
</BaseLayout>
