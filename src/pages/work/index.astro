---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import { Boxes, Building2, ChartBar, Factory, Workflow } from "@lucide/astro";

const projects = (await getCollection("projects", ({ data }) => data.published && data.type === "work"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectIcon = (label?: string) => {
  const normalized = (label || "").toLowerCase();
  if (normalized.includes("public")) return Building2;
  if (normalized.includes("food")) return Factory;
  if (normalized.includes("sales")) return ChartBar;
  if (normalized.includes("enterprise")) return Boxes;
  return Workflow;
};
---

<BaseLayout title={`Project Stories | ${site.siteName}`} description={`${site.siteName}'s Dynamics 365, Copilot, Power Platform, ERP, and business transformation project stories.`}>
  <main>
    <section class="page-hero media-hero">
      <div>
        <p class="eyebrow">Project stories</p>
        <h1>Work across people, process, and platforms.</h1>
        <p>Business-facing stories from CRM modernization, cloud migration, enterprise operations, and automation. Each one opens with the setting, then goes deeper into the people, decisions, and outcomes.</p>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.projects} alt="Abstract layered enterprise operating model with connected business signals" />
        <figcaption>Business systems in context</figcaption>
      </figure>
    </section>

    <section class="story-list">
      {projects.map((project, index) => {
        const Icon = projectIcon(project.data.label || project.data.sector);
        return (
        <article class="story-card story-icon-card">
          <div class="story-meta">
            <div class="story-card-icon-row"><Icon class="story-card-icon" size={28} strokeWidth={1.5} aria-hidden="true" /><span>Project story · {String(index + 1).padStart(2, "0")}</span></div>
            <span>{project.data.sector || project.data.label}</span>
            <strong>{project.data.clientType}</strong>
          </div>
          <div>
            <p class="story-card-kicker">Project story</p>
            <h2>{project.data.title}</h2>
            <p class="story-card-hook">{project.data.storyHook || project.data.executiveSummary || project.data.summary}</p>
            {project.data.storySetting && <p class="story-card-context">{project.data.storySetting}</p>}
            {project.data.scale && <p class="story-scale">{project.data.scale}</p>}
            <p class="story-card-actions"><a href={`/projects/${project.id}/`}>Read full project story</a></p>
            <p class="story-outcome">Business outcome: {project.data.outcome}</p>
          </div>
        </article>
        );
      })}
    </section>
  </main>
</BaseLayout>
