---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import { Mail } from "@lucide/astro";
---

<BaseLayout title={`Contact | ${site.siteName}`} description={`Contact ${site.siteName} for CRM, Dynamics 365, Power Platform, and AI workflow conversations.`}>
  <main>
    <section class="contact-hero banner-panel" data-banner="contact" data-banner-label="Conversation">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Let’s talk about business systems.</h1>
        <p>Open to conversations about Dynamics 365, Copilot, Power Platform, CRM modernization, and practical AI.</p>
        <div class="hero-actions">
          <a class="primary-link" href={site.linkedinUrl} rel="noopener noreferrer">Connect on LinkedIn</a>
          <a class="secondary-link" href="/work/">Read project stories</a>
        </div>
        {site.email && (
          <a class="contact-email-card" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
            <span class="contact-email-label"><Mail size={18} strokeWidth={1.6} aria-hidden="true" /> Email</span>
            <strong>{site.email}</strong>
            <span class="contact-email-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
      <figure class="page-hero-visual contact-hero-visual">
        <img src={site.visuals.contact} alt="Abstract bridge connecting two glowing conversation nodes" />
        <figcaption>Conversations into connected work</figcaption>
      </figure>
    </section>
  </main>
</BaseLayout>
