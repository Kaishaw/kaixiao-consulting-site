---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";

const projects = await getCollection("projects", ({ data }) => data.published && data.type === "ai");
---

<BaseLayout title={`Labs & Demos | ${site.siteName}`} description={`${site.siteName}'s prototypes, demos, and applied experiments across AI, automation, CRM, and business systems.`}>
  <main>
    <section class="page-hero media-hero">
      <div>
        <p class="eyebrow">Labs & demos</p>
        <h1>A place for prototypes, experiments, and useful things I am testing.</h1>
        <p>This is broader than a dedicated AI page. It can include AI demos, CRM experiments, automation concepts, product sketches, videos, and small tools that make an idea easier to understand.</p>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.labs} alt="Abstract agentic workflow with connected nodes, feedback loops, and actions" />
        <figcaption>Context → reasoning → action</figcaption>
      </figure>
    </section>

    {projects.map((project) => (
      <section class="section">
        <article class="featured-case">
          <div>
            <p class="eyebrow">{project.data.label}</p>
            <h2>{project.data.title}</h2>
            <p>{project.data.executiveSummary || project.data.summary}</p>
            {project.data.demoType && <p class="story-scale">Format: {project.data.demoType}</p>}
            <p class="story-outcome">Outcome: {project.data.outcome}</p>
          </div>
          <div class="case-actions">
            {project.data.externalUrl && <a class="primary-link" href={project.data.externalUrl} rel="noopener noreferrer">Project overview</a>}
            {project.data.videoUrl && <a class="secondary-link" href={project.data.videoUrl} rel="noopener noreferrer">Watch demo</a>}
            <a class="secondary-link" href={`/projects/${project.id}/`}>Project details</a>
          </div>
        </article>
      </section>
    ))}
  </main>
</BaseLayout>
