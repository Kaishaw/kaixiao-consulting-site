---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import ai from "../../data/ai.json";
import { BrainCircuit, ChartBar, Database, Factory, FileCheck, RefreshCw, Route, ShieldCheck, UserRoundCheck, UsersRound, Workflow } from "@lucide/astro";

const projects = await getCollection("projects", ({ data }) => data.published && data.type === "ai");

const labNotes = (project: (typeof projects)[number]) => [
  {
    number: "01",
    label: "The setting",
    title: "From scattered input to a useful next step",
    body: project.data.storySetting || project.data.summary,
  },
  {
    number: "02",
    label: "The tension",
    title: "Useful without pretending",
    body: project.data.storyTension || project.data.storyTrigger || project.data.businessContext,
  },
  {
    number: "03",
    label: "The design principle",
    title: "A workflow, not a chatbot",
    body: project.data.storyDecisions[0]?.body || project.data.rolePerspective,
  },
].filter((note) => note.body);

const visualAlt = (project: (typeof projects)[number]) => project.data.coverImage
  ? `${project.data.title} cover image`
  : "Abstract agentic workflow with connected nodes, feedback loops, and actions";

const principleIcons = {
  workflow: Workflow,
  data: Database,
  control: ShieldCheck,
  adoption: UsersRound,
};

const caseIcons = {
  recruiting: UserRoundCheck,
  finance: Database,
  legal: FileCheck,
  crm: UsersRound,
  manufacturing: Factory,
  "decision support": Route,
};

const sequenceIcons = [Workflow, Database, Route, ChartBar, RefreshCw];
const watchoutIcons = [BrainCircuit, Database, ShieldCheck];
const labNoteIcons = [Database, Route, ShieldCheck];
const projectJourneyIcons = [Workflow, Database, RefreshCw, ShieldCheck];
---

<BaseLayout title={`AI Practice | ${site.siteName}`} description={ai.lede}>
  <main>
    <section class="page-hero media-hero">
      <div>
        <p class="eyebrow">{ai.eyebrow}</p>
        <h1>{ai.title}</h1>
        <p>{ai.lede}</p>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.labs} alt="Abstract agentic workflow with connected nodes, feedback loops, and actions" />
        <figcaption>Context → Reasoning → Action</figcaption>
      </figure>
    </section>

    <section class="section ai-practice-section">
      <div class="section-heading">
        <p class="eyebrow">What travels well</p>
        <h2>Four ideas worth carrying into enterprise work.</h2>
      </div>
      <div class="detail-grid ai-principles">
        {ai.principles.map((principle) => {
          const Icon = principleIcons[principle.label.toLowerCase() as keyof typeof principleIcons];
          return (
            <a class="ai-principle-card" href={principle.href}>
              <div class="ai-card-top">
                <Icon class="ai-card-icon" size={28} strokeWidth={1.5} aria-hidden="true" />
                <span>{principle.number}</span>
              </div>
              <p class="eyebrow">{principle.label}</p>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section ai-cases-section">
      <div class="section-heading">
        <p class="eyebrow">Enterprise examples</p>
        <h2>What these patterns make concrete.</h2>
      </div>
      <div class="ai-case-grid">
        {ai.cases.map((item) => {
          const Icon = caseIcons[item.label.toLowerCase() as keyof typeof caseIcons];
          return (
            <a class="ai-case-card" href={item.href}>
              <div class="ai-case-number">
                <Icon class="ai-case-icon" size={28} strokeWidth={1.5} aria-hidden="true" />
                <span>{item.number}</span>
              </div>
              <div>
                <p class="eyebrow">{item.label}</p>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <p class="ai-case-evidence">{item.evidence}</p>
                <p class="ai-case-takeaway">{item.takeaway}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section ai-sequence-section">
      <div class="section-heading">
        <p class="eyebrow">A delivery pattern</p>
        <h2>A sequence you can use on a real program.</h2>
      </div>
      <ol class="ai-sequence-list">
        {ai.sequence.map((step, index) => {
          const Icon = sequenceIcons[index];
          return (
            <li>
              <div class="ai-sequence-top">
                <Icon class="ai-sequence-icon" size={25} strokeWidth={1.5} aria-hidden="true" />
                <span>{step.number}</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="section ai-watchouts-section">
      <div class="section-heading">
        <p class="eyebrow">A useful filter</p>
        <h2>What not to copy blindly.</h2>
      </div>
      <div class="detail-grid ai-watchouts">
        {ai.watchouts.map((item, index) => {
          const Icon = watchoutIcons[index];
          return (
            <a class="ai-watchout-card" href={item.href}>
              <div class="ai-card-top">
                <Icon class="ai-card-icon" size={26} strokeWidth={1.5} aria-hidden="true" />
                <span>{item.number}</span>
              </div>
              <p class="eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section ai-labs-intro">
      <div class="section-heading">
        <p class="eyebrow">Labs & demos</p>
        <h2>Turn the pattern into something you can try.</h2>
      </div>
      <p class="ai-labs-lede">Working experiments across AI, automation, CRM, and business systems. Each project makes the journey from a business question to a useful next action visible.</p>
    </section>

    {projects.map((project) => (
      <section class="section labs-section">
        <article class="featured-case ai-project-case">
          <div class="ai-project-copy">
            <div class="ai-project-heading">
              <p class="eyebrow">{project.data.label}</p>
              <span class={`status-chip ${project.data.externalUrl ? "is-live" : "is-revision"}`}>
                {project.data.externalUrl ? "Available to try" : "In revision"}
              </span>
            </div>
            <h2>{project.data.title}</h2>
            <p class="ai-project-hook">{project.data.storyHook || project.data.executiveSummary || project.data.summary}</p>
            <p>{project.data.summary}</p>
            <div class="ai-project-facts">
              {project.data.demoType && <span><strong>Format</strong>{project.data.demoType}</span>}
              {project.data.scale && <span><strong>Scope</strong>{project.data.scale}</span>}
            </div>
            <p class="story-outcome">Outcome: {project.data.outcome}</p>
            <div class="case-actions">
              {project.data.externalUrl && <a class="primary-link" href={project.data.externalUrl} rel="noopener noreferrer">Open project</a>}
              {project.data.videoUrl && <a class="secondary-link" href={project.data.videoUrl} rel="noopener noreferrer">Watch demo</a>}
              <a class="secondary-link" href={`/projects/${project.id}/`}>Project details</a>
              {!project.data.externalUrl && <span class="project-status-note">Public link paused while the next version is being prepared.</span>}
            </div>
          </div>
          <figure class="ai-project-visual">
            <img src={project.data.coverImage || site.visuals.labs} alt={visualAlt(project)} />
            <figcaption>
              <span>01</span><strong>Context</strong><i>→</i><strong>Reasoning</strong><i>→</i><strong>Action</strong>
            </figcaption>
          </figure>
        </article>

        <div class="lab-notes-grid">
          {labNotes(project).map((note, index) => {
            const Icon = labNoteIcons[index] || BrainCircuit;
            return (
              <article class={`lab-note lab-note-${index + 1} icon-note-card`}>
                <div class="lab-note-top"><div class="lab-note-icon-group"><Icon class="lab-note-icon" size={25} strokeWidth={1.5} aria-hidden="true" /><span>{note.number}</span></div><span>{note.label}</span></div>
                <h3>{note.title}</h3>
                <p>{note.body}</p>
              </article>
            );
          })}
        </div>

        {project.data.storyJourney.length > 0 && (
          <section class="lab-flow">
            <div class="section-heading">
              <p class="eyebrow">Workflow in view</p>
              <h2>Make the transformation visible.</h2>
            </div>
            <ol class="lab-flow-list">
              {project.data.storyJourney.map((step, index) => {
                const Icon = projectJourneyIcons[index] || Workflow;
                return <li class="lab-flow-step"><div class="lab-flow-top"><Icon size={24} strokeWidth={1.5} aria-hidden="true" /><span>{String(index + 1).padStart(2, "0")}</span></div><h3>{step.title}</h3><p>{step.body}</p></li>;
              })}
            </ol>
          </section>
        )}
      </section>
    ))}
  </main>
</BaseLayout>
