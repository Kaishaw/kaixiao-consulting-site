---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";

const posts = (await getCollection("blog", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`Blog | ${site.siteName}`} description={`Projects, demos, industry insights, and technology perspectives from ${site.siteName}.`}>
  <main>
    <section class="page-hero text-only">
      <p class="eyebrow">Blog</p>
      <h1>Things I build, learn, test, and want to explain clearly.</h1>
      <p>The Blog is the detailed layer: project notes, demos, tutorials, case notes, and longer-form writing. For shorter directional thinking, visit Insights.</p>
    </section>

    <section class="section blog-grid">
      {posts.map((post) => (
        <article class="route-card blog-card">
          <span>{post.data.category}</span>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.summary}</p>
          <small>{post.data.contentType || "article"} · {post.data.date.toLocaleDateString("en-CA")}</small>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
