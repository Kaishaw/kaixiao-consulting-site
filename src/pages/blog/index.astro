---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";

const posts = (await getCollection("blog", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const contentTypeLabel = (contentType?: string) => {
  if (!contentType) return "Article";
  if (contentType === "case-note") return "Case note";
  return contentType.charAt(0).toUpperCase() + contentType.slice(1);
};

const contentTypeArt = (contentType?: string) => {
  const art = {
    opinion: { visual: site.visuals.insights, mark: "↗" },
    article: { visual: site.visuals.home, mark: "＋" },
    "case-note": { visual: site.visuals.projects, mark: "◇" },
    tutorial: { visual: site.visuals.labs, mark: "→" },
  };
  return art[contentType as keyof typeof art] || art.article;
};
---

<BaseLayout title={`Blog | ${site.siteName}`} description={`Projects, demos, industry insights, and technology perspectives from ${site.siteName}.`}>
  <main>
    <section class="page-hero media-hero">
      <div>
        <p class="eyebrow">Blog</p>
        <h1>Notes on systems, AI, and the work between them.</h1>
        <p>Longer posts on projects, demos, industry signals, and practical delivery. Start with Insights for shorter opinions.</p>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.insights} alt="Abstract field of technology signals resolving into a clear constellation" />
        <figcaption>Signals, translated into practice</figcaption>
      </figure>
    </section>

    <section class="section blog-grid">
      {posts.map((post) => (
        <article class={`route-card blog-card${post.data.featuredInsight ? " featured-blog-card" : ""}`} data-content-type={post.data.contentType || "article"}>
          <div class="blog-card-art">
            <img src={post.data.coverImage || contentTypeArt(post.data.contentType).visual} alt="" />
            <span>{contentTypeLabel(post.data.contentType)}</span>
            <strong aria-hidden="true">{contentTypeArt(post.data.contentType).mark}</strong>
          </div>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.summary}</p>
          <small>{post.data.category} · {post.data.date.toLocaleDateString("en-CA")}</small>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
