---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import insights from "../../data/insights.json";
import { ArrowUpRight, BrainCircuit, ChartBar, Database, FileText, Workflow } from "@lucide/astro";

const posts = (await getCollection("blog", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = posts.filter((post) => post.data.featuredInsight);
const insightPosts = featuredPosts.length ? featuredPosts : posts.slice(0, 3);
const featuredInsight = insightPosts[0];

const contentTypeIcons = {
  opinion: ArrowUpRight,
  article: FileText,
  "case-note": Database,
  tutorial: Workflow,
};
const pillarIcons = [ArrowUpRight, ChartBar, Workflow];
const sourceIcons = [Database, Workflow, ChartBar, BrainCircuit];
---

<BaseLayout title={`Insights | ${site.siteName}`} description={`${site.siteName}'s perspective on CRM, ERP, Power Platform, contact centers, and applied AI.`}>
  <main>
    <section class="page-hero media-hero insights-hero">
      <div>
        <p class="eyebrow">{insights.eyebrow}</p>
        <h1>{insights.title}</h1>
        <p>{insights.lede}</p>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.insights} alt="Abstract field of technology signals resolving into a clear constellation" />
        <figcaption>From signal to point of view</figcaption>
      </figure>
    </section>

    {featuredInsight && (
      <section class="section featured-insight-section">
        <article class="featured-case featured-insight icon-featured-card">
          <div>
            <div class="featured-insight-top"><BrainCircuit size={28} strokeWidth={1.5} aria-hidden="true" /><span>Featured insight</span></div>
            <p class="eyebrow">Featured insight · {featuredInsight.data.insightTopic || featuredInsight.data.category}</p>
            <h2>{featuredInsight.data.title}</h2>
            <p>{featuredInsight.data.summary}</p>
          </div>
          <div class="featured-insight-side">
            <span>My view</span>
            <p>{featuredInsight.data.insightSummary || featuredInsight.data.summary}</p>
            <a class="primary-link" href={`/blog/${featuredInsight.id}/`}>Read the full insight</a>
          </div>
        </article>
      </section>
    )}

    <section class="section detail-grid insight-pillars">
      {insights.pillars.map((pillar, index) => {
        const Icon = pillarIcons[index] || Workflow;
        return (
          <article class="section-icon-card">
            <div class="section-icon-card-top"><Icon class="section-icon" size={28} strokeWidth={1.5} aria-hidden="true" /><span>{String(index + 1).padStart(2, "0")}</span></div>
            <p class="section-icon-label">{pillar.label}</p>
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </article>
        );
      })}
    </section>

    <section class="note-list">
      <div class="section-heading"><p class="eyebrow">Latest notes</p><a class="secondary-link" href="/blog/">Open the Blog</a></div>
      {insightPosts.map((post, index) => {
        const Icon = contentTypeIcons[post.data.contentType as keyof typeof contentTypeIcons] || FileText;
        return (
          <article class="note-list-card">
            <div class="note-list-marker"><Icon size={28} strokeWidth={1.5} aria-hidden="true" /><span>{post.data.insightTopic || post.data.category} · {String(index + 1).padStart(2, "0")}</span></div>
            <div><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.insightSummary || post.data.summary}</p></div>
          </article>
        );
      })}
    </section>

    <section class="section source-section">
      <div><p class="eyebrow">Reading list</p><h2>Public sources I am watching.</h2><p class="source-note">{insights.sourceNote}</p></div>
      <div class="source-grid">
        {[
          ["Dynamics 365 Contact Center", "https://www.microsoft.com/en-us/dynamics-365/products/contact-center"],
          ["Microsoft Power Platform", "https://www.microsoft.com/en-us/power-platform"],
          ["Dynamics 365 Sales", "https://www.microsoft.com/en-us/dynamics-365/products/sales"],
          ["Dynamics 365 Customer Service", "https://www.microsoft.com/en-us/dynamics-365/products/customer-service"],
        ].map(([label, href], index) => {
          const Icon = sourceIcons[index];
          return <a class="source-card" href={href} rel="noopener noreferrer"><Icon size={24} strokeWidth={1.5} aria-hidden="true" /><span>{label}</span><ArrowUpRight size={20} strokeWidth={1.5} aria-hidden="true" /></a>;
        })}
      </div>
    </section>
  </main>
</BaseLayout>
