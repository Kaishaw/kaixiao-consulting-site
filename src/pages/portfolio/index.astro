---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import timeline from "../../data/timeline.json";
---

<BaseLayout title={`Portfolio | ${site.siteName}`} description={`${site.siteName}'s career timeline, business systems experience, CRM and ERP transformation work, and applied AI focus.`}>
  <main>
    <section class="page-hero media-hero">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h1>A career in business systems.</h1>
        <p>Business analysis, Dynamics 365, Power Platform, ERP-adjacent operations, and applied AI.</p>
        <a class="secondary-link timeline-jump" href="#career-timeline">View career timeline</a>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.portfolio} alt="Abstract luminous career path moving through connected business-system milestones" />
        <figcaption>People, process, systems</figcaption>
      </figure>
    </section>

    <section class="section timeline-section" id="career-timeline">
      <div class="section-heading">
        <div><p class="eyebrow">Career timeline</p><h2>From systems to studio work.</h2></div>
        <p class="timeline-note">A concise path from graduation to CRM, ERP, and applied AI.</p>
      </div>
      <ol class="career-timeline">
        {timeline.entries.map((entry) => (
          <li>
            <div class="timeline-period">{entry.period}</div>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-content">
              <p class="eyebrow">{entry.location}</p>
              <h3>{entry.title}</h3>
              <p>{entry.summary}</p>
              <div class="tag-list">{entry.themes.map((theme) => <span>{theme}</span>)}</div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section detail-grid">
      <article class="banner-panel" data-banner="labs" data-banner-label="Current focus"><span>Current focus</span><h3>Dynamics 365 + applied AI</h3><p>CRM modernization, Copilot, service workflows, automation, reporting, and adoption.</p></article>
      <article class="banner-panel" data-banner="portfolio" data-banner-label="Foundation"><span>Education</span><h3>Southwest Jiaotong University</h3><p>An engineering foundation that shaped how I think about systems, process, and scale.</p></article>
      <article class="banner-panel" data-banner="projects" data-banner-label="Context"><span>Professional setting</span><h3>Canadian business systems</h3><p>Recent work across CRM, customer operations, and modernization.</p></article>
      <article class="banner-panel" data-banner="insights" data-banner-label="Capability"><span>Certifications</span><h3>Microsoft business applications</h3><p>Dynamics 365, Power Platform, Dataverse, Power Automate, and Copilot.</p></article>
    </section>

    <section class="section split-section">
      <div><p class="eyebrow">How I work</p><h2>How I work.</h2></div>
      <div class="copy-block">
        <p>I start with the workflow: who owns the data, where handoffs happen, and what decisions matter.</p>
        <p>Then I turn that understanding into practical delivery: process maps, user stories, acceptance criteria, automation rules, testing, and rollout notes.</p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading"><p class="eyebrow">Strengths</p><h2>Where I add value.</h2></div>
      <div class="soft-card-grid">
        <article class="banner-panel" data-banner="projects" data-banner-label="Discovery"><h3>Business process discovery</h3><p>Finding the real process behind the request.</p></article>
        <article class="banner-panel" data-banner="portfolio" data-banner-label="Design"><h3>CRM functional design</h3><p>Turning customer work into usable CRM behavior.</p></article>
        <article class="banner-panel" data-banner="labs" data-banner-label="Automation"><h3>Power Platform automation</h3><p>Replacing repetitive work with controlled workflows.</p></article>
        <article class="banner-panel" data-banner="insights" data-banner-label="Adoption"><h3>User adoption</h3><p>Helping teams understand and use the change.</p></article>
      </div>
    </section>
  </main>
</BaseLayout>
