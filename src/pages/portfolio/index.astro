---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import timeline from "../../data/timeline.json";
import { BrainCircuit, Boxes, BookOpen, Building2, Database, UsersRound, Workflow } from "@lucide/astro";

const detailCards = [
  {
    label: "Current focus",
    title: "Dynamics 365 + applied AI",
    body: "CRM modernization, Copilot, service workflows, automation, reporting, and adoption.",
    Icon: BrainCircuit,
  },
  {
    label: "Education",
    title: "Southwest Jiaotong University",
    body: "An engineering foundation that shaped how I think about systems, process, and scale.",
    Icon: BookOpen,
  },
  {
    label: "Professional setting",
    title: "Canadian business systems",
    body: "Recent work across CRM, customer operations, and modernization.",
    Icon: Building2,
  },
  {
    label: "Certifications",
    title: "Microsoft business applications",
    body: "Dynamics 365, Power Platform, Dataverse, Power Automate, and Copilot.",
    Icon: Database,
  },
];

const strengthCards = [
  { label: "Discovery", title: "Business process discovery", body: "Finding the real process behind the request.", Icon: Workflow },
  { label: "Design", title: "CRM functional design", body: "Turning customer work into usable CRM behavior.", Icon: Boxes },
  { label: "Automation", title: "Power Platform automation", body: "Replacing repetitive work with controlled workflows.", Icon: Database },
  { label: "Adoption", title: "User adoption", body: "Helping teams understand and use the change.", Icon: UsersRound },
];
---

<BaseLayout title={`Portfolio | ${site.siteName}`} description={`${site.siteName}'s career timeline, business systems experience, CRM and ERP transformation work, and applied AI focus.`}>
  <main>
    <section class="page-hero media-hero">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h1>A career in business systems.</h1>
        <p>Business analysis, Dynamics 365, Power Platform, ERP-adjacent operations, and applied AI.</p>
        <a class="secondary-link timeline-jump" href="#career-timeline">View career timeline</a>
      </div>
      <figure class="page-hero-visual">
        <img src={site.visuals.portfolio} alt="Abstract luminous career path moving through connected business-system milestones" />
        <figcaption>People, process, systems</figcaption>
      </figure>
    </section>

    <section class="section timeline-section" id="career-timeline">
      <div class="section-heading">
        <div><p class="eyebrow">Career timeline</p><h2>From systems to studio work.</h2></div>
        <p class="timeline-note">A concise path from graduation to CRM, ERP, and applied AI.</p>
      </div>
      <ol class="career-timeline">
        {timeline.entries.map((entry) => (
          <li>
            <div class="timeline-period">{entry.period}</div>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-content">
              <p class="eyebrow">{entry.location}</p>
              <h3>{entry.title}</h3>
              <p>{entry.summary}</p>
              <div class="tag-list">{entry.themes.map((theme) => <span>{theme}</span>)}</div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section detail-grid">
      {detailCards.map((card, index) => {
        const Icon = card.Icon;
        return (
          <article class="section-icon-card">
            <div class="section-icon-card-top"><Icon class="section-icon" size={28} strokeWidth={1.5} aria-hidden="true" /><span>{String(index + 1).padStart(2, "0")}</span></div>
            <p class="section-icon-label">{card.label}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        );
      })}
    </section>

    <section class="section split-section">
      <div><p class="eyebrow">How I work</p><h2>How I work.</h2></div>
      <div class="copy-block">
        <p>I start with the workflow: who owns the data, where handoffs happen, and what decisions matter.</p>
        <p>Then I turn that understanding into practical delivery: process maps, user stories, acceptance criteria, automation rules, testing, and rollout notes.</p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading"><p class="eyebrow">Strengths</p><h2>Where I add value.</h2></div>
      <div class="soft-card-grid">
        {strengthCards.map((card, index) => {
          const Icon = card.Icon;
          return (
            <article class="section-icon-card">
              <div class="section-icon-card-top"><Icon class="section-icon" size={28} strokeWidth={1.5} aria-hidden="true" /><span>{String(index + 1).padStart(2, "0")}</span></div>
              <p class="section-icon-label">{card.label}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
